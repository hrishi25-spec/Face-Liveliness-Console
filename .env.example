# PostgreSQL connection
# POSTGRES_PASSWORD must be set — no default for security
# SECRET
POSTGRES_PASSWORD=
POSTGRES_DB=pad_liveness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application database role (runtime role, DML only — cannot ALTER TABLE)
# POSTGRES_APP_PASSWORD must be set — no default for security
# SECRET
POSTGRES_APP_PASSWORD=

# Flyway migration role (owns public schema, runs DDL)
# Uses the same password as POSTGRES_PASSWORD (bootstrap superuser's password)
POSTGRES_MIGRATE_USER=pad_migrate

# Optional request body cap in bytes (default 24 MB)
# MAX_REQUEST_BODY_BYTES=25165824

# Rate limiting (fixed windows)
# RATE_LIMIT_ENABLED=true
# SESSION_CREATE_LIMIT=30   # POST /api/v1/sessions per IP per minute
# FRAME_LIMIT=60            # POST frames + challenge validates per session per 10s

# Floor a per-workflow challengeTimeoutMs is raised to (default 15000 ms, hard
# minimum 1000 ms). Raising it only makes the flow more patient; lower it only
# in tests, where it shortens the real-time timeout path.
# MIN_CHALLENGE_WINDOW_MS=15000

# Peers whose X-Forwarded-For / X-Real-IP may be believed when keying the
# per-IP rate-limit budget (comma-separated IPs or CIDR blocks). Empty = trust
# nobody, so the budget keys on the socket address. Set it to your reverse proxy
# or Docker gateway, e.g. TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
# TRUSTED_PROXIES=

# Admin API key — required by PUT /api/v1/config/* (fail-closed: config
# updates are refused until this is set to a non-blank value).
# Generate one with: openssl rand -hex 32
# SECRET
MOSIP_ADMIN_API_KEY=

# Operator API key — presented as X-Operator-API-Key on operator routes
# (GET /api/v1/auth/role), and answered there as the OPERATOR role. The admin
# key is accepted on those routes too, so this is the smaller role. Minimum 16
# characters when set and it must differ from the admin key; blank leaves the
# operator surface closed (nobody is ever answered OPERATOR) rather than open.
# Generate one with: openssl rand -hex 32
# SECRET
MOSIP_OPERATOR_API_KEY=

# Optional HMAC key for tamper-evident config audit hashes (minimum 16 chars).
# SECRET
MOSIP_AUDIT_HMAC_SECRET=
# Previous key used to verify historical hashes during a keyed rotation.
# Keep it configured while /api/v1/config/audit/verify reports retiredKeyHashes=true.
# SECRET
# MOSIP_AUDIT_HMAC_PREVIOUS_SECRET=

# Optional list of keys whose values should be redacted from audit logs
# AUDIT_REDACTION_KEYS=password,secret,token,key

# Database connection pool size (default 5)
# DB_POOL_SIZE=5

# Liveness diagnostics endpoint (default false)
# LIVENESS_DIAGNOSTICS_ENABLED=false

# Application database username (default pad_runtime)
# POSTGRES_APP_USER=pad_runtime

# Server port (default 8000)
# SERVER_PORT=8000

# Tomcat max threads (default 50)
# TOMCAT_THREADS_MAX=50
