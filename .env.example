# PostgreSQL connection
# POSTGRES_PASSWORD must be set — no default for security
# SECRET
POSTGRES_PASSWORD=
POSTGRES_DB=pad_liveness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application database role (runtime role, DML only — cannot ALTER TABLE)
# POSTGRES_APP_PASSWORD must be set — no default for security
# SECRET
POSTGRES_APP_PASSWORD=

# Flyway migration role (owns public schema, runs DDL)
# Uses the same password as POSTGRES_PASSWORD (bootstrap superuser's password)
POSTGRES_MIGRATE_USER=pad_migrate

# Optional request body cap in bytes (default 24 MB)
# MAX_REQUEST_BODY_BYTES=25165824

# Rate limiting (fixed windows)
# RATE_LIMIT_ENABLED=true
# SESSION_CREATE_LIMIT=30   # POST /api/v1/sessions per IP per minute
# FRAME_LIMIT=60            # POST frames + challenge validates per session per 10s

# Floor a per-workflow challengeTimeoutMs is raised to (default 15000 ms, hard
# minimum 1000 ms). Raising it only makes the flow more patient; lower it only
# in tests, where it shortens the real-time timeout path.
# MIN_CHALLENGE_WINDOW_MS=15000

# Peers whose X-Forwarded-For / X-Real-IP may be believed when keying the
# per-IP rate-limit budget (comma-separated IPs or CIDR blocks). Empty = trust
# nobody, so the budget keys on the socket address. Set it to your reverse proxy
# or Docker gateway, e.g. TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
# TRUSTED_PROXIES=

# ---- Authentication ----
# Accounts and sessions replace the shared admin API key: the privileged surface
# (PUT /api/v1/config/*, GET /api/v1/eval/threshold-sweep and user management) is
# reached by signing in at POST /api/v1/auth/login with a username and password.
#
# First-supervisor bootstrap: creates one SUPERVISOR account, and only on a
# database that has no accounts at all — leaving the pair set can never re-create
# an account or reset a password, so forgetting to unset it is a no-op rather
# than a backdoor. The account must change its password at first sign-in. Both or
# neither; startup fails on one alone. Unset both once you have signed in.
# SECRET
# MOSIP_AUTH_BOOTSTRAP_PASSWORD=
# MOSIP_AUTH_BOOTSTRAP_USERNAME=supervisor

# Session lifetime in seconds (default 3600). Bounds a stolen token.
# MOSIP_AUTH_TOKEN_TTL_SECONDS=3600
# Consecutive failed sign-ins before an account locks (default 5), and how long
# the lock lasts in seconds (default 900). Stored, so a restart cannot clear it.
# MOSIP_AUTH_MAX_FAILED_ATTEMPTS=5
# MOSIP_AUTH_LOCKOUT_SECONDS=900
# BCrypt cost: log2 of the work per password verification (default 12, ~300 ms on
# the 2-core target). Values below 10 are refused outside the dev profile.
# MOSIP_AUTH_BCRYPT_COST=12
# Send the session cookie only over https (default false). Set true when TLS
# terminates in front of this service — a Secure cookie is dropped over plain
# http, where the sign-in would appear to succeed and silently not.
# MOSIP_AUTH_COOKIE_SECURE=false

# Operator API key — presented as X-Operator-API-Key on the operator routes
# (GET /api/v1/auth/role and the two read-only feeds), where it proves the
# OPERATOR role. It is never accepted on a privileged route, so a leaked key can
# read feeds and cannot write a policy or an account. Minimum 16 characters when
# set; blank closes key-based access to those routes (nobody is answered OPERATOR
# by a key) while a signed-in account still reaches them. Generate one with:
# openssl rand -hex 32
# SECRET
MOSIP_OPERATOR_API_KEY=

# Optional HMAC key for tamper-evident config audit hashes (minimum 16 chars).
# SECRET
MOSIP_AUDIT_HMAC_SECRET=
# Previous key used to verify historical hashes during a keyed rotation.
# Keep it configured while /api/v1/config/audit/verify reports retiredKeyHashes=true.
# SECRET
# MOSIP_AUDIT_HMAC_PREVIOUS_SECRET=

# Optional list of keys whose values should be redacted from audit logs
# AUDIT_REDACTION_KEYS=password,secret,token,key

# Database connection pool size (default 5)
# DB_POOL_SIZE=5

# Liveness diagnostics endpoint (default false)
# LIVENESS_DIAGNOSTICS_ENABLED=false

# Application database username (default pad_runtime)
# POSTGRES_APP_USER=pad_runtime

# Server port (default 8000)
# SERVER_PORT=8000

# Tomcat max threads (default 50)
# TOMCAT_THREADS_MAX=50
