# PostgreSQL connection
POSTGRES_USER=mosip
POSTGRES_PASSWORD=change_me
POSTGRES_DB=pad_liveness
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# App
APP_ENV=development
LOG_LEVEL=INFO

# Key that PUT /api/v1/config/{workflow_type} must present as X-Admin-API-Key.
# Leave it blank and that route is refused (403) rather than left open: a policy
# write can lower the passive threshold or switch liveness off, so it must never
# be reachable unauthenticated. Generate one with `openssl rand -hex 32`.
MOSIP_ADMIN_API_KEY=
