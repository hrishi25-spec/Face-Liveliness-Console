<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>io.mosip.liveness</groupId>
  <artifactId>pad-liveness-backend</artifactId>
  <!-- CI-friendly version: resolves to the <revision> property below
       unless overridden on the command line (-Drevision=...), which is
       how the release job stamps the tag's version into the jar. Every
       other build keeps the snapshot default, so local artifacts and
       start.sh keep their familiar name. -->
  <version>${revision}</version>
  <packaging>jar</packaging>
  <name>MOSIP Face Liveness &amp; PAD Service (FastAPI-style Spring Boot)</name>
  <description>Face liveness detection and Presentation Attack Detection (PAD) for MOSIP Registration Client workflows: resident registration, operator authentication, and supervisor authentication.</description>

  <properties>
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Spring Boot 3.3 manages Testcontainers 1.19, whose Docker API client
         is too old for current Docker daemons. Keep the suite on the latest
         compatible 1.x line. -->
    <testcontainers.version>1.21.4</testcontainers.version>
    <revision>1.0.0-SNAPSHOT</revision>
    <!-- Desktop (JavaFX) overlay UI. Provided by the MOSIP Registration Client
         host at runtime — see the javafx-controls dependency below. -->
    <!-- Pinned to the JDK 17 the project targets (`java.version` below) and the
         CI runners use. JavaFX 21 itself is Java-17 bytecode, but TestFX's
         openjfx-monocle 21.0.2 build is class-file 65 (Java 21), so bumping
         this silently breaks the headless overlay tests with
         UnsupportedClassVersionError on a JDK 17 fork. Move both together, and
         only with a JDK 21 toolchain. -->
    <javafx.version>21.0.2</javafx.version>
  </properties>

  <dependencies>
    <!-- Spring Boot Web (REST API) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Spring Boot Data JPA (ORM) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Spring Boot Validation (request DTO validation) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- PostgreSQL driver -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- BCrypt password hashing (at.favre.lib). Chosen over hand-rolled
         PBKDF2 for the operator account passwords behind POST
         /api/v1/auth/login:
           * the hash is self-describing ($2a$12$...), so the cost and the
             algorithm travel with the stored value and a future rehash can
             happen at login instead of a flag day;
           * verification is constant time inside the library, which is the
             property this service needs and the one easiest to get wrong by
             hand;
           * it is memory-hard-ish in the way that matters here — 2^12 cost
             on the 2-core target is ~300 ms per verification, which is a
             deliberate ceiling on offline guessing.
         Zero third-party code beyond at.favre.lib:bytes (a ~20 KB byte-array
         helper by the same author); nothing else is pulled in. -->
    <dependency>
      <groupId>at.favre.lib</groupId>
      <artifactId>bcrypt</artifactId>
      <version>0.10.2</version>
    </dependency>

    <!-- Flyway (DB migrations, replaces Alembic) -->
    <!-- Spring Boot 4 moved Flyway autoconfiguration out of spring-boot-autoconfigure
         into the spring-boot-flyway module. flyway-core alone is no longer
         wired, so without this starter no migration ever runs and the service
         fails validation on a fresh database ("missing table [audit_logs]").
         The starter brings the same flyway-core, plus the auto-configuration. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- SpringDoc OpenAPI (Swagger UI, like FastAPI /docs) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>3.1.1</version>
    </dependency>

    <!-- Jackson 3 — Boot 4's JSON mapper, in the `tools.jackson` packages.
         Declared directly because this service uses it itself: the JPA
         attribute converters and LivenessHttpClient hold an ObjectMapper. It
         previously resolved only transitively, so those classes compiled
         against the Jackson 2 jar springdoc drags in — a coupling that worked
         by accident and broke silently when the mapper that Spring MVC
         actually uses changed. The version is managed by spring-boot-starter-parent.

         Note on the Jackson 2 jars still in the tree: springdoc 3.x emits the
         OpenAPI document through swagger-core 2.2.x, which is Jackson 2 based,
         so swagger-core keeps its own mapper at runtime. Nothing in this
         service's code may use it; JacksonRuntimeGateTest enforces that.
         Jackson's annotations are shared: Jackson 3 uses
         com.fasterxml.jackson.annotation, which is why the DTOs' @JsonInclude
         imports stay as they are. -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- H2 in-memory database (dev profile / zero-dependency local run) -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- OpenCV (headless, for face detection / image processing in services).
         Scope is compile (not provided) so the native libraries are bundled in
         the executable jar and loadLocally() works under `java -jar`. -->
    <dependency>
      <groupId>org.openpnp</groupId>
      <artifactId>opencv</artifactId>
      <version>4.9.0-0</version>
    </dependency>

    <!-- ONNX Runtime: desktop-JVM inference for the MiniFASNet face
         anti-spoofing model (Apache-2.0). The TFLite runtime is an
         Android-only AAR (see docs/status-report.md §4), so ONNX Runtime is
         the offline, cross-platform path for the same weights. -->
    <dependency>
      <groupId>com.microsoft.onnxruntime</groupId>
      <artifactId>onnxruntime</artifactId>
      <version>1.31.0</version>
    </dependency>

    <!-- Micrometer (timers for the per-frame pipeline). Version is managed by
         spring-boot-starter-parent and resolves to the same 1.13.3 already on
         the classpath transitively as micrometer-observation, so this adds no
         third-party code that Spring Boot does not already ship. We take only
         micrometer-core — not spring-boot-starter-actuator — because the service
         already has its own /api/v1/metrics surface and does not need the
         actuator endpoint set. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>

    <!-- Lombok (reduce boilerplate) -->
    <!--
      Desktop (JavaFX) liveness overlay — LivenessChallengeOverlay.fxml +
      controller. Scope `provided`: the overlay runs inside the MOSIP
      Registration Client (a JavaFX application) which supplies the JavaFX
      runtime; this service never starts a toolkit. Provided keeps JavaFX on
      the compile/test classpath while staying out of the packaged service.
    -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Spring Boot 4 split the test slices out of spring-boot-test-autoconfigure
         into per-technology modules. WebMvcTest/AutoConfigureMockMvc live in
         spring-boot-webmvc-test, DataJpaTest in spring-boot-data-jpa-test
         (which pulls spring-boot-jpa-test for TestEntityManager and
         spring-boot-jdbc-test for AutoConfigureTestDatabase), and
         TestRestTemplate in spring-boot-resttestclient. Without these the
         slice imports do not resolve at all. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-resttestclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Boot 4 moved RestTemplate/RestTemplateBuilder out of spring-web into
         spring-boot-restclient. TestRestTemplate's autoconfiguration needs the
         builder on the classpath, otherwise it fails to introspect and the
         integration context will not start. Test scope only: the service
         itself talks to the engine over java.net.http, not RestTemplate. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit's version belongs to spring-boot-starter-parent (Boot 4.1.1
         manages 6.0.3), not to this pom. Pinning the aggregator alone does not
         move the tests: dependency management keeps junit-jupiter-api,
         -params and -engine on the parent's version, so a 6.1.3 pin here put
         the aggregator at 6.1.3 next to 6.0.3 modules - every test green, and
         the engine a version the pom never mentioned.
         DependencyOwnershipGateTest.versionFamiliesStayInStep now fails a
         half-upgraded family. To move JUnit, move all of it: set
         junit-jupiter.version or import org.junit:junit-bom. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Headless JavaFX: the desktop overlay can only be proved to render by
         actually instantiating it, and neither a build machine nor a CI runner
         has a display. Monocle is the headless glass platform (a screen with no
         window system behind it); testfx-core supplies the FX-thread test
         plumbing (asyncFx + waitFor) that runs each step on the JavaFX
         Application Thread and reports the failure on the test thread. Both are
         test-only — like the JavaFX dependencies above, none of this ships in
         the service jar. -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-core</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
    <!-- Monocle is not optional here, and neither is the version: it is the
         headless glass platform, and it is built against the exact JavaFX it
         runs on. The jdk-12.0.1+2 build that TestFX's own documentation
         suggests dies with an AbstractMethodError on Window._updateViewSize as
         soon as the first window is created, so this tracks javafx.version
         above (17.0.10). -->
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>openjfx-monocle</artifactId>
      <version>${javafx.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
            <!-- Provided scope still lands in BOOT-INF/lib — the service
                 never starts a JavaFX toolkit (the RC host does), so keep
                 the overlay's compile-time libs out of the runnable jar. -->
            <exclude>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-base</artifactId>
            </exclude>
            <exclude>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-graphics</artifactId>
            </exclude>
            <exclude>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-controls</artifactId>
            </exclude>
            <exclude>
              <groupId>org.openjfx</groupId>
              <artifactId>javafx-fxml</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- Headless JavaFX for every fork. The overlay smoke test starts the
               JavaFX toolkit, and a CI runner has no X server, so glass is
               pinned to Monocle's Headless screen and the rasteriser to
               software; without these the toolkit start fails on the runner
               and the smoke test could only ever pass on a developer machine.
               They are inert for the non-JavaFX tests in the suite. -->
          <systemPropertyVariables>
            <glass.platform>Monocle</glass.platform>
            <monocle.platform>Headless</monocle.platform>
            <prism.order>sw</prism.order>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!--
    Slim jar: same runnable app, minus the natives for platforms it cannot run on.

    Why this exists — `org.openpnp:opencv` (109 MB) ships natives for EIGHT
    platforms: linux x86_64/x86_32/ARMv7/ARMv8, osx x86_64/ARMv8, windows
    x86/x64. `com.microsoft.onnxruntime` (41 MB) ships four plus a 54 MB macOS
    .dSYM debug blob. A Linux x86_64 CI runner and the Docker image need
    exactly one of each; the other ~250 MB is payload that can never load there.

    The important subtlety — the opencv jar holds the Java bindings AND the
    natives. Dropping the whole dependency is NOT a slimming trick: Spring then
    cannot introspect beans whose method signatures mention `Mat` and the app
    dies at startup with `NoClassDefFoundError: org/opencv/core/Mat` before any
    request is served. Only the *native* entries are removed; the API classes
    stay, so the pipeline runs normally and the app is fully functional.

    How — spring-boot's <excludes> only drops whole dependencies and cannot
    filter *inside* one, so this profile unpacks both jars into
    target/classes (which repackage embeds verbatim in BOOT-INF/classes) while
    excluding the originals from BOOT-INF/lib. Net effect is the same layout
    with the unused platforms removed.

    Result: ~209 MB -> ~120 MB, and the jar boots and runs the real pipeline on
    linux x86_64. On any other platform the natives are absent, so AppConfig's
    catch fires and the app degrades exactly as it does in the Alpine image
    today (nu.pattern ships no musl build, so its glibc .so never loads there
    either) — it serves the API, config/audit, rate limiting and console, and
    frame processing reports the documented "OpenCV native library unavailable".

      ./mvnw clean package -DskipTests -Pslim

    pomtail:
    - `clean` is required. The unpack writes into target/classes, so a slim
      build followed by a non-slim build would leave a linux-only native in
      target/classes ahead of the full opencv jar on the classpath, and OpenCV
      would then fail to load on a macOS/Windows dev machine. Always clean when
      switching profiles.
    - <mainClass> is pinned deliberately. With <classifier> set, spring-boot
      3.3.3's auto-detection writes
      `Start-Class: org.springframework.boot.loader.launch.JarLauncher`, so the
      loader launches *itself* and recurses to StackOverflowError before Spring
      starts. Pinning it makes the manifest deterministic.
    - lombok and the JavaFX set are restated in <excludes> because Maven merges
      profile plugin configuration positionally onto the base list; restating
      every base exclude makes the result independent of merge order.
    - The classifier is what stops this from being mistaken for the real
      artifact: the repackaged jar is `-slim.jar`, the plain jar is left beside
      it. It also means two jars match the
      `target/pad-liveness-backend-*.jar` glob used by the Dockerfile COPY and
      the CI upload step, so neither build may pass -Pslim.
    - Opt-in only (never activeByDefault): the default package must keep
      producing the fully runnable, cross-platform jar, and the CI test jobs
      depend on the real natives being on the classpath.
  -->
  <profiles>
    <profile>
      <id>slim</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>strip-unused-platform-natives</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.openpnp</groupId>
                      <artifactId>opencv</artifactId>
                      <version>4.9.0-0</version>
                      <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                      <!-- Keep only linux/x86_64 — the platform this jar targets. -->
                      <excludes>
                        nu/pattern/opencv/linux/x86_32/**,nu/pattern/opencv/linux/ARMv7/**,nu/pattern/opencv/linux/ARMv8/**,nu/pattern/opencv/osx/**,nu/pattern/opencv/windows/**
                      </excludes>
                    </artifactItem>
                    <artifactItem>
                      <groupId>com.microsoft.onnxruntime</groupId>
                      <artifactId>onnxruntime</artifactId>
                      <version>1.31.0</version>
                      <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                      <!-- Keep only linux-x64. The osx-aarch64 exclude also drops
                           the ~54 MB .dSYM debug bundle nested inside it. -->
                      <excludes>
                        ai/onnxruntime/native/osx-aarch64/**,ai/onnxruntime/native/linux-aarch64/**,ai/onnxruntime/native/win-x64/**
                      </excludes>
                    </artifactItem>
                  </artifactItems>
                  <!-- Repackaging on every build would rewrite ~40 MB of classes
                       for no reason when only the native payload changed. -->
                  <overWriteReleases>false</overWriteReleases>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <classifier>slim</classifier>
              <mainClass>io.mosip.liveness.PadLivenessApplication</mainClass>
              <!-- The originals were unpacked into BOOT-INF/classes above; keeping
                   them in BOOT-INF/lib too would just double the payload. -->
              <excludes>
                <exclude>
                  <groupId>org.projectlombok</groupId>
                  <artifactId>lombok</artifactId>
                </exclude>
                <exclude>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-base</artifactId>
                </exclude>
                <exclude>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-graphics</artifactId>
                </exclude>
                <exclude>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-controls</artifactId>
                </exclude>
                <exclude>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-fxml</artifactId>
                </exclude>
                <exclude>
                  <groupId>org.openpnp</groupId>
                  <artifactId>opencv</artifactId>
                </exclude>
                <exclude>
                  <groupId>com.microsoft.onnxruntime</groupId>
                  <artifactId>onnxruntime</artifactId>
                </exclude>
              </excludes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Linux installers: a plain `./mvnw package` also produces

        target/dist/pad-liveness_<version>_amd64.deb          (systemd unit inside)
        target/dist/pad-liveness-<version>-1.x86_64.rpm       (same unit and menu entry)
        target/dist/pad-liveness-<version>-x86_64.AppImage    (AppRun opens the console)

      The work lives in scripts/package-linux.sh: jpackage is a CLI over an
      application image, the RPM is assembled with a generated spec, and the
      AppImage step has no Maven equivalent, so the profile only names the
      phase and passes the version through.

      Activated by the OS, not activeByDefault, and on purpose:
      - activeByDefault is switched off by any -P on the command line, so
        `./mvnw package -Pslim` would silently stop building installers. The OS
        condition survives that.
      - It is inert on macOS and Windows, where jpackage cannot make a .deb.

      Skipping is not fatal outside strict mode, because packaging is not a
      test: a workstation without dpkg-deb or rpmbuild still gets its jar and
      the other installers plus a warning, and the existing CI package jobs
      keep building jars on a runner where a tool is missing. The *Linux
      packages* CI job runs with -Dlinux.package.strict=true and inspects and
      boots the result, which is what actually guarantees every artifact.

      -Dlinux.package.skip=true disables it for a jar-only build; the developer
      launchers pass it so they never spend time packaging or downloading
      appimagetool.
    -->
    <profile>
      <id>linux-package</id>
      <activation>
        <os>
          <family>unix</family>
          <name>linux</name>
        </os>
      </activation>
      <properties>
        <linux.package.skip>false</linux.package.skip>
        <linux.package.strict>false</linux.package.strict>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>linux-installers</id>
                <!-- After repackage: the script picks up the jar the previous
                     phase just wrote. -->
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${linux.package.skip}</skip>
                  <executable>${project.basedir}/scripts/package-linux.sh</executable>
                  <environmentVariables>
                    <PAD_PACKAGE_STRICT>${linux.package.strict}</PAD_PACKAGE_STRICT>
                  </environmentVariables>
                  <arguments>
                    <argument>--version</argument>
                    <argument>${project.version}</argument>
                    <argument>--target</argument>
                    <argument>${project.build.directory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Windows installer: on Windows a plain `\mvnw.cmd package` also produces

        target\dist\pad-liveness-<version>.exe

      through scripts/package-windows.ps1, which builds the jpackage
      application image with the console subsystem enabled (this is a server,
      so its startup log has to be visible) and then the WiX-backed installer
      from it.

      Same shape as `linux-package` above, and for the same reasons: activated
      by the OS so it is inert on Linux and macOS and cannot be switched off by
      a stray -P, and a missing tool (jpackage, or WiX for the .exe) skips that
      half with a warning rather than failing a developer's jar build. The
      *Windows installer* CI job passes -Dwindows.package.strict=true so a
      missing WiX is a red build there.

      -Dwindows.package.skip=true disables it for a jar-only build.
    -->
    <profile>
      <id>windows-package</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <windows.package.skip>false</windows.package.skip>
        <windows.package.strict>false</windows.package.strict>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>windows-installer</id>
                <!-- After repackage: the script picks up the jar the previous
                     phase just wrote. -->
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${windows.package.skip}</skip>
                  <executable>powershell.exe</executable>
                  <environmentVariables>
                    <PAD_PACKAGE_STRICT>${windows.package.strict}</PAD_PACKAGE_STRICT>
                  </environmentVariables>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-NonInteractive</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}\scripts\package-windows.ps1</argument>
                    <argument>-Version</argument>
                    <argument>${project.version}</argument>
                    <argument>-Target</argument>
                    <argument>${project.build.directory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
